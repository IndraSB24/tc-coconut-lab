# ==============================================================================
# 🥥 TC Coconut Lab — Multi-Currency Digital Wallet
# Environment Configuration Template
# ==============================================================================
#
# NOTE: This application is engineered with ZERO EXTERNAL INFRASTRUCTURE dependencies.
# All operational defaults function out-of-the-box without requiring a .env file.
#
# 1. Database:
#    Persisted via embedded local SQLite (file:./dev.db in app-core/prisma/).
#    Zero database connection string or credentials needed.
#
# 2. Foreign Exchange Rates:
#    Integrated with Frankfurter API (https://api.frankfurter.dev).
#    Free, open-source reference rates from European Central Bank (zero API keys required).
#
# 3. User Authentication:
#    Pre-seeded simulated user session ('user-simulated' / Indra SB).
#    Zero external auth providers, JWT secrets, or cookie session salts required.
# ==============================================================================

# Application Port (Default: 3000)
# PORT=3000

# Node Environment
NODE_ENV=development
